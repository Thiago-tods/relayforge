# Copy to deploy/.env and set your own local-only values. Never commit deploy/.env.
POSTGRES_USER=relayforge
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=relayforge
POSTGRES_PORT=5432

REDIS_PASSWORD=change-me-local-only
REDIS_PORT=6379

NATS_PORT=4222

# Application connection settings (read by the Go processes, not by Docker Compose).
# Keep the user, password, port and database in sync with the values above.
# Local development only: TLS is disabled because the port is bound to 127.0.0.1.
RELAYFORGE_DATABASE_URL=postgres://relayforge:change-me-local-only@127.0.0.1:5432/relayforge?sslmode=disable
# Admin URL of a DISPOSABLE server for integration tests. The role needs CREATEDB.
# Tests create and drop uniquely named databases; never point this at data you care about.
RELAYFORGE_TEST_DATABASE_URL=postgres://relayforge:change-me-local-only@127.0.0.1:5432/postgres?sslmode=disable
